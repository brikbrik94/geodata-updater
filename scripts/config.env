#!/bin/bash

# =================================================================
# ZENTRALE KONFIGURATION (config.env)
# =================================================================

# --- Hauptverzeichnisse ---
export INSTALL_DIR="/srv/scripts"
export TILES_DIR="/srv/tiles"
export ASSETS_DIR="/srv/assets"
export INFO_DIR="/srv/info"
export DOCS_DIR="/srv/docs"

# --- Externe Dienste / ORS ---
export ORS_DIR="/srv/ors"
# Der Name der Datei, die ORS als Input erwartet (muss zum docker-compose passen)
export ORS_PBF_FILE="osm_file.pbf"
# Wo liegen die PBF-Quelldateien für den ORS-Graph (z.B. im OSM-Plugin)
export OSM_BUILD_DIR="/mnt/geodata/geodata-osm"


# --- URLs (für Info-Generierung) ---
export TILES_BASE_URL="https://tiles.oe5ith.at"
export ASSETS_BASE_URL="https://tiles.oe5ith.at/assets"

# --- System ---
export USER_NAME="geo"
